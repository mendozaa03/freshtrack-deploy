{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://freshtrack-deploy-production.up.railway.app/api/:path*"
    },
    {
      "source": "/salud",
